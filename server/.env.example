# --- Servidor ---
PORT=4000
CORS_ORIGIN=*

# --- Supabase (opcional para datos; REQUERIDO para login/usuarios) ---
# Si están vacías, el server usa un cache EN MEMORIA y el login queda deshabilitado.
# Al completarlas, persiste en data_cache y habilita auth + gestión de usuarios.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Emails (separados por coma) que se vuelven admin automáticamente al arrancar.
# Útil para crear el primer administrador. Ej: ADMIN_EMAILS=vos@somosciclico.com
ADMIN_EMAILS=

# --- Intervalos de polling (ms) ---
POLL_DOLAR_MS=60000
POLL_CAMMESA_MS=60000
POLL_DATOSGOB_MS=21600000

# --- CAMMESA ---
# 1002 = total SADI (nacional). Otras regiones: GBA, NEA, NOA, Centro, Patagonia, etc.
CAMMESA_REGION=1002

# --- datos.gob.ar (override opcional de series, formato key:id separado por coma) ---
# Por defecto usa las series verificadas en src/sources/datosgob.ts
# DATOSGOB_SERIES=ipc:148.3_INIVELNAL_DICI_M_26,salarios:149.1_TL_INDIIOS_OCTU_0_21
